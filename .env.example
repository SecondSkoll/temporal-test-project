# .env.example
# =============
# Copy this file to .env and fill in the values for local development.
# This file is safe to commit; .env is listed in .gitignore.

# ── Temporal connection ────────────────────────────────────────────────────────
# Use the default local dev server address when running `temporal server start-dev`
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TASK_QUEUE=docs-pipeline

# ── Git / docs repository ──────────────────────────────────────────────────────
# The HTTPS URL of the Git repository where generated documentation is committed.
# For local development, you can use a local bare Git repo or a test GitHub repo.
DOCS_REPO_URL=https://github.com/your-org/ubuntu-docs-output

# Personal Access Token with 'contents: write' permission on DOCS_REPO_URL.
# NEVER commit this value to version control.
GIT_PAT=your-github-pat-here

# ── LLM endpoint ──────────────────────────────────────────────────────────────
# Point to the local mock server for development; replace with the real endpoint
# URL for staging/production.
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=mock-key
LLM_MODEL=gpt-4o

# ── Triage limits ──────────────────────────────────────────────────────────────
# Increase these for testing with large upstream repositories.
CLONE_TIMEOUT_SECONDS=120
MAX_CLONE_SIZE_MB=50
